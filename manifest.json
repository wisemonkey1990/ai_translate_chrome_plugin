{
  "manifest_version": 3,
  "name": "AI Web Translator",
  "version": "1.1.0",
  "description": "Web page translation using LLM, an alternative to Chrome's built-in translation feature",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/shared/constants.js",
        "src/shared/storage.js",
        "src/shared/i18n.js",
        "src/shared/translation-cache.js",
        "src/content/state.js",
        "src/content/dom-text.js",
        "src/content/dom-apply.js",
        "src/content/page-ui.js",
        "src/content/translation-queue.js",
        "src/content/translator.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  }
}
